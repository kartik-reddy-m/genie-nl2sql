# Databricks workspace host (no trailing slash)
DATABRICKS_HOST=https://dbc-fcb3311b-2b4b.cloud.databricks.com

# Databricks Personal Access Token (PAT). KEEP SECRET. Rotate if leaked.
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Genie space id
GENIE_SPACE_ID=01f178e8f2751f9e8e896570d7d6e289

# Outbound HTTP timeout to Databricks per request (seconds)
GENIE_REQUEST_TIMEOUT=60

# Server-side polling for a single process-message operation
GENIE_POLL_INTERVAL=1.5
GENIE_POLL_TIMEOUT=150
