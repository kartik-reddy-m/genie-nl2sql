# Base URL of the genie-service
GENIE_SERVICE_URL=http://localhost:8001

# Outbound HTTP timeout to genie-service (seconds).
# Must exceed genie-service GENIE_POLL_TIMEOUT (default 150s).
CONVERSATION_REQUEST_TIMEOUT=180

# Redis connection for conversation history
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth ---
# Leave GOOGLE_CLIENT_ID blank to DISABLE auth (local dev). Set it in production.
GOOGLE_CLIENT_ID=
# Optional allowlist (comma-separated). If both blank, any verified Google account is allowed.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=
